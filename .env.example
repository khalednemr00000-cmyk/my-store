# ==============================================================================
# SOUQ ELITE - PRODUCTION-READY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgres@localhost:5432/souq_elite?schema=public
# For Supabase/Neon: postgresql://username:password@ep-host.region.neon.tech/souq_elite?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souq_elite?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="سوق النخبة | Souq Elite"
NEXT_PUBLIC_STORE_DESCRIPTION="المتجر الإلكتروني الرائد للتسوق الفاخر في الشرق الأوسط"
NEXT_PUBLIC_CURRENCY="SAR"
NEXT_PUBLIC_CURRENCY_SYMBOL="ر.س"

# Security & Authentication
JWT_SECRET="super_secret_jwt_key_at_least_32_characters_long_souq_elite_2026"
SESSION_EXPIRY_DAYS=7

# Super Admin Initial Credentials (Used during db seed)
SUPERADMIN_EMAIL="admin@souqelite.com"
SUPERADMIN_PASSWORD="AdminSecurePassword2026!"

# Payments Configuration
# Cash on Delivery enabled by default
ENABLE_COD="true"

# Stripe (Optional in development - Mocks available)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_secret"

# PayPal (Optional in development - Mocks available)
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_SECRET="mock_paypal_secret"
PAYPAL_MODE="sandbox" # sandbox or live

# Email Provider (Optional in development - Console logger fallback)
EMAIL_PROVIDER="mock" # mock or resend or smtp
RESEND_API_KEY="re_mock_api_key"
EMAIL_FROM="orders@souqelite.com"

# Cloud Storage Provider (Optional in development - Local fallback)
STORAGE_PROVIDER="local" # local or cloudinary or s3
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
